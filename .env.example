# ── Server ──────────────────────────────────────────────────────
PORT=3001                 # Port the NestJS backend listens on
FRONTEND_URL=             # Frontend origin for CORS (e.g. http://localhost:3000)

# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT session signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgres://user:pass@host:port/db)

# ── Auth (Kimi OAuth) ──────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL
KIMI_OPEN_URL=            # Kimi Open Platform URL

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login
